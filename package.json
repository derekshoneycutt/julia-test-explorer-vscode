{
  "name": "julia-test-explorer",
  "displayName": "Julia Test Explorer",
  "description": "Discover and run Julia test sets in VS Code's Test Explorer.",
  "publisher": "derekshoneycutt",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/derekshoneycutt/julia-test-explorer-vscode.git"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.jl"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Julia Test Explorer",
      "properties": {
        "juliaTestExplorer.juliaPath": {
          "type": "string",
          "default": "julia",
          "scope": "resource",
          "description": "Path to the Julia executable. When left as julia, Julia Test Explorer also checks the Julia extension setting and standard Juliaup locations."
        },
        "juliaTestExplorer.testArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional Julia arguments passed before the test runner script."
        },
        "juliaTestExplorer.testSuites": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "description": "Julia test entrypoints with explicit project and working-directory ownership.",
          "items": {
            "type": "object",
            "required": ["name", "entrypoint", "project"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for the suite."
              },
              "entrypoint": {
                "type": "string",
                "description": "Suite entrypoint. Relative paths resolve from the workspace folder."
              },
              "project": {
                "type": "string",
                "description": "Julia project used with --project. Relative paths resolve from the workspace folder."
              },
              "cwd": {
                "type": "string",
                "description": "Suite working directory. Defaults to project and resolves from the workspace folder."
              }
            },
            "additionalProperties": false
          }
        },
        "juliaTestExplorer.exclude": {
          "type": "string",
          "default": "**/{.git,node_modules,out,dist}/**",
          "scope": "resource",
          "description": "Glob pattern excluded from Julia test discovery."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --skip-license --out julia-test-explorer.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:helper": "julia --startup-file=no helper/discovery_test.jl && julia --startup-file=no helper/runner_test.jl",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}